    { "id": "avatar-1", "kind": "avatar", "parent": "member-1", "label": "Avatar, pink", "rect": [80, 880, 96, 96] },
    { "id": "member-2", "kind": "card", "parent": "team", "label": "Secondary on call", "rect": [430, 860, 340, 200] },
    { "id": "avatar-2", "kind": "avatar", "parent": "member-2", "label": "Avatar, teal", "rect": [450, 880, 96, 96] },
