    { "id": "log", "kind": "scroll", "parent": "page", "label": "Activity log", "rect": [40, 1140, 1120, 300], "rows": 40 },

    { "id": "story", "kind": "paragraph", "parent": "page", "label": "Long paragraph", "rect": [40, 1480, 720, 480] }
  ]
